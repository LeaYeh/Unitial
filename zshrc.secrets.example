# Shell secrets — copy to ~/.zshrc.secrets and fill in. NEVER commit the real file.
# ~/.zshrc sources this file if present: [[ -f ~/.zshrc.secrets ]] && source ~/.zshrc.secrets

# Claude account tokens — run `claude setup-token` while logged into each account
export CLAUDE_TOKEN_PERSONAL=
export CLAUDE_TOKEN_WORK=

# GitHub PAT for ghcr.io (scopes: read:packages / write:packages)
export GHCR_TOKEN=
